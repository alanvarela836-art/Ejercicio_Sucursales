package com.ejercicioclase.objetos;
import java.util.Random;

public class Curso {
    private String nombredelCurso;
    private int cantidadMaxima;
    private int cantidadInscritos;

    public Curso(String nombredelCurso, int cantidadInscritos) {
        this.nombredelCurso = nombredelCurso;
        Random random = new Random();
        int maxAleatorio = random.nextInt(35 - 20 + 1) + 20;
        this.cantidadMaxima = maxAleatorio;

        if (cantidadInscritos > maxAleatorio) {
            System.out.println("El número de alumnos no puede exceder a " + maxAleatorio);
            this.cantidadInscritos = maxAleatorio;
        } else {
            this.cantidadInscritos = cantidadInscritos;
        }
    }
    public String getNombredelCurso() {
        return nombredelCurso;
    }
    public int getCantidadMaxima() {
        return cantidadMaxima;
    }
    public int getCantidadInscritos() {
        return cantidadInscritos;
    }
    @Override
    public String toString() {
        return "Curso: [" + nombredelCurso + "], Inscritos: [" + cantidadInscritos + "], Capacidad Máxima: [" + cantidadMaxima + "]";
    } 
}
